IMAGE_NAME=flutter-android-builder:flutter-3.35.6
FLUTTER_VERSION=3.35.6
PROJECT_DIR=/path/to/monorepo
ANDROID_PROJECT_DIR=apps/app/android

# Example flow for a Melos/monorepo Flutter project.
PRE_BUILD_COMMAND="dart pub get && dart run melos bs"
BUILD_COMMAND="dart run melos run build:android"

# Enable this only when pubspec Git dependencies need credentials.
# GIT_HOST=gitee.com
# GIT_USERNAME=your-username
# GIT_TOKEN=your-token
