# Docker image versions.
IMAGE_NAME=flutter-android-builder:flutter-3.35.6
FLUTTER_VERSION=3.35.6
NODE_VERSION=22.11.0
PNPM_VERSION=9.15.2

# Android SDK packages.
ANDROID_PLATFORM=android-35
ANDROID_BUILD_TOOLS=35.0.0
ANDROID_NDK=27.0.12077973
ANDROID_EXTRA_PACKAGES="platforms;android-31,platforms;android-34,platforms;android-36,cmake;3.22.1"

# Target project and build command.
PROJECT_DIR=/path/to/flutter/project
ANDROID_PROJECT_DIR=android
BUILD_COMMAND="flutter build apk --release"

# Optional mirrors.
PUB_HOSTED_URL=https://pub.flutter-io.cn
FLUTTER_STORAGE_BASE_URL=https://storage.flutter-io.cn
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# Optional private Git dependencies.
# GIT_HOST=gitee.com
# GIT_USERNAME=your-username
# GIT_TOKEN=your-token
